FROM node:18-alpine
WORKDIR /app

# Build tools and Postgres headers needed for pg native bindings
RUN apk add --no-cache python3 make g++ postgresql-dev

COPY package*.json ./
RUN npm install --production

COPY . .

COPY docker-entrypoint.bot.sh /usr/local/bin/docker-entrypoint.bot.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.bot.sh \
  && sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.bot.sh

ENTRYPOINT ["/bin/sh", "/usr/local/bin/docker-entrypoint.bot.sh"]
